		_MainTex("MainTex", 2D) = "white" {}
		[HDR]_MainColor("MainColor", Color) = (0.5019608,0.5019608,0.5019608,1)
		_MaskTex("MaskTex", 2D) = "white" {}
		[Enum(R,0,A,1)]_MaskRASwitch("MaskRASwitch", Range( 0 , 1)) = 0
		_Strength("Strength", Range( 0 , 10)) = 1
		_SpeedX1("SpeedX", Float) = 0
		_SpeedY1("SpeedY", Float) = 0
		[Enum(Off,0,On,1)]_DepthFade1("DepthFade", Float) = 0
		_Distance1("Distance", Range( 0 , 1)) = 1
		_FrontAndBehind("FrontAndBehind", Range( -20 , 20)) = 0
		[HideInInspector] _texcoord( "", 2D ) = "white" {}

